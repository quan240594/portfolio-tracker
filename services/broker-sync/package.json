{
  "name": "@portfolio/broker-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/lib.ts",
  "types": "./src/lib.ts",
  "exports": {
    ".": "./src/lib.ts",
    "./aws": "./src/aws.ts"
  },
  "scripts": {
    "build": "node ../../scripts/lambda/build.mjs broker-sync",
    "package": "node ../../scripts/lambda/build.mjs broker-sync && node ../../scripts/lambda/package.mjs broker-sync",
    "sync": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@portfolio/aws": "workspace:*",
    "@portfolio/platform": "workspace:*",
    "@portfolio/shared": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^20.19.43",
    "archiver": "^8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.1.9"
  }
}
