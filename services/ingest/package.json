{
  "name": "@portfolio/ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/portable.ts",
  "types": "./src/portable.ts",
  "exports": {
    ".": "./src/portable.ts"
  },
  "scripts": {
    "build": "node ../../scripts/lambda/build.mjs ingest",
    "package": "node ../../scripts/lambda/build.mjs ingest && node ../../scripts/lambda/package.mjs ingest",
    "dev": "tsx watch src/local-poller.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@portfolio/aws": "workspace:*",
    "@portfolio/platform": "workspace:*",
    "@portfolio/shared": "workspace:*",
    "csv-parse": "^7.0.3"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1150.0",
    "@aws-sdk/client-eventbridge": "^3.1150.0",
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/client-sqs": "^3.1150.0",
    "@aws-sdk/lib-dynamodb": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@eslint/js": "^9.39.5",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^20.19.43",
    "archiver": "^8.0.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.1.9"
  }
}
