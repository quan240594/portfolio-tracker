// Free plan only: no [limits], no routes or custom domains, and no paid binding (no R2, KV, Queues or D1).
// Nothing personal is stored here: the secrets are Worker secrets (`wrangler secret put`), the three variables below are
// injected at deploy time (`pnpm run deploy:app`, see README.md) or come from `.dev.vars` for `pnpm run dev`.
//
// Optional Worker secrets of the price service (`wrangler secret put <NAME>`; none is needed to deploy, a missing one only switches
// that market-data source off and `GET /api/prices/status` says so): TWELVEDATA_API_KEY, EODHD_API_KEY, COINGECKO_API_KEY,
// ALPHAVANTAGE_API_KEY. Optional plain variables (defaults in packages/prices/src/config.ts): COINGECKO_COIN_IDS, EODHD_DAILY_LIMIT,
// ALPHAVANTAGE_DAILY_LIMIT, EU_REFRESH_HOURS, FX_HISTORY_START and the CALENDAR_* settings; add them to "vars" below to change them.
//
// Company logos (see docs/architecture.md, "Company logos"): optional variables LOGO_SOURCES (default "t212,logodev,google,duckduckgo", "off" = none; "google,duckduckgo" switches the
// undocumented Trading 212 logo bucket off), LOGO_T212_BASE (https *.amazonaws.com origin only),
// LOGO_HOURLY_LIMIT (default 30) and LOGO_NEGATIVE_TTL_DAYS (default 7), and the optional secret LOGO_DEV_TOKEN that switches the token-based source on.
//
// Dividend push notifications (optional, see README.md): the Worker secret VAPID_PRIVATE_KEY (`wrangler secret put VAPID_PRIVATE_KEY`) and the
// plain variable VAPID_PUBLIC_KEY (passed at deploy time like ORIGIN: `VAPID_PUBLIC_KEY=... pnpm run deploy:app`); both come from
// `pnpm run vapid:generate`. Without them the feature is simply off. Optional: PUSH_ALLOWED_HOSTS (comma separated push-service hosts).
// Earnings summaries (see docs/architecture.md, "Earnings summaries"): the Workers AI binding below (free-plan compatible: 10,000 neurons a day, nothing
// is billed without a paid plan) and the variable SEC_CONTACT, the complete User-Agent every request to the SEC declares, for example
// "PortfolioTracker/1.0 (personal use; you@example.com)". It is passed at deploy time like ORIGIN (`SEC_CONTACT='...' pnpm run deploy:app`) and never committed;
// without it the feature reports "not configured" and sends nothing. Optional: EARNINGS_AI_MODEL (default @cf/meta/llama-3.1-8b-instruct-fp8),
// EARNINGS_AI_DAILY_NEURONS (default 6000, at most 8000), EARNINGS_BACKFILL_QUARTERS (releases read per holding, default 4, at most 8) and the existing secret ALPHAVANTAGE_API_KEY (EPS estimates).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  // csv-parse (the CSV import) uses Buffer and a few Node built-ins.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Static files are served straight from the asset store (free, no Worker invocation); only these paths run the Worker.
    "run_worker_first": ["/api/*", "/auth/*", "/usage", "/health"]
  },
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "ai": { "binding": "AI" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // One daily trigger: it only re-arms the Hub's alarm (the schedules live in the Hub, see SCHEDULED_JOBS).
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "BASE_CURRENCY": "EUR",
    // Placeholders: the real values are passed with --var at deploy time. While they are placeholders the app answers 503 NOT_CONFIGURED.
    "ORIGIN": "https://replace-with-your-origin.invalid",
    "OWNER_GITHUB_ID": "replace-with-your-numeric-github-id",
    "GITHUB_CLIENT_ID": "replace-with-your-oauth-client-id"
  }
}
