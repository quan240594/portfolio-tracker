# Base URL of the REST API. Defaults to "/api" (proxied to http://localhost:3001 by the Vite dev server).
# In AWS this is the API Gateway URL, injected at build time.
VITE_API_BASE_URL=
# Run fully mocked in the browser (MSW service worker). `pnpm dev:mock` sets this implicitly.
VITE_USE_MOCKS=false
# Company logos (`GET /api/logos/<symbol>`, served by the Cloudflare deployment only): on by default outside the demo, always off in mock mode and tests.
# `on` also turns them on in mock mode (used by the Playwright logo run); `off` shows the neutral monogram everywhere.
VITE_LOGOS=
# Public base path (Vite `base`), e.g. /portfolio-tracker/ for GitHub Pages (`pnpm build:pages` sets it). Default "/".
VITE_BASE_PATH=
# Demo (mock) mode only: https URL of your own deployed app. When set, the banner's "Switch to real data" is a link to it;
# otherwise it opens a how-to dialog. Anything that is not an https URL is ignored. The Pages workflow reads it from the repo variable REAL_APP_URL.
VITE_REAL_APP_URL=

# Sign-in. "none" (default) = no login screen (mock/demo mode, local dev against the demo-mode API).
# "cognito" = Amazon Cognito (SRP) + TOTP MFA; the deploy workflow sets these from the Terraform outputs
# (cognito_user_pool_id, cognito_user_pool_client_id, cognito_region). Mock mode always ignores them.
# "github" = personal Cloudflare deployment: the Worker serves the SPA and the API on one origin and keeps the sign-in in an HttpOnly
# cookie (no other settings; VITE_API_BASE_URL must then stay empty or a path such as /api).
VITE_AUTH_MODE=none
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Optional: derived from the pool id (eu-west-1_xxx -> eu-west-1) when empty.
VITE_COGNITO_REGION=
